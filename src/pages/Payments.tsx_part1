import { useCallback, useEffect, useMemo, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { Card, CardContent } from "@/components/ui/card";
import { SafeCard } from "@/components/ui/SafeCard";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { PageHeader } from "@/components/PageHeader";
import { StatusBadge } from "@/components/StatusBadge";
import { supabase } from "@/integrations/supabase/client";
import { useAuth } from "@/contexts/AuthContext";
import { formatCurrency, formatDate, formatCompetence, PAYMENT_STATUS_LABELS, PAYMENT_TYPE_LABELS, PAYMENT_KIND_LABELS, type PaymentStatus, type PaymentType, type PaymentKind } from "@/lib/status";
import { Search, X, User, Tag, Clock, Building2, AlertTriangle, UserCheck, RefreshCcw, Sparkles, Archive, Inbox, MessageCircleQuestion, ChevronDown } from "lucide-react";
import { usePaymentRisk } from "@/hooks/usePaymentRisk";
import { RiskBadge } from "@/components/payment-detail/RiskBadge";
import { Tooltip, TooltipContent, TooltipTrigger } from "@/components/ui/tooltip";
import { CompanyCombobox, type CompanyOption } from "@/components/CompanyCombobox";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { Checkbox } from "@/components/ui/checkbox";
import { cn } from "@/lib/utils";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import { evaluateSla, type SlaSetting, type CompanySlaOverride } from "@/lib/sla";
import { TERMINAL_STATUSES } from "@/lib/paymentFlow";
import { toast } from "sonner";

const Payments = () => {
  const { roles, user } = useAuth();
  const [selected, setSelected] = useState<Set<string>>(new Set());
  const [reprocessing, setReprocessing] = useState(false);
  const [reprocessProgress, setReprocessProgress] = useState<{ done: number; total: number } | null>(null);
  const [searchParams, setSearchParams] = useSearchParams();
  const [payments, setPayments] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState<string[]>([]);
  const [companyFilter, setCompanyFilter] = useState<CompanyOption | null>(null);
  const [slaSettings, setSlaSettings] = useState<SlaSetting[]>([]);
  const [slaOverrides, setSlaOverrides] = useState<CompanySlaOverride[]>([]);
  const { getGroupRisk } = usePaymentRisk();

  const load = useCallback(async () => {
    setLoading(true);
    const [pRes, slaRes, ovrRes] = await Promise.all([
      supabase
        .from("payments")
        .select("*, payment_company_groups(id, company_name, status, total_amount, items_count)")
        .order("created_at", { ascending: false }),
      supabase.from("sla_settings").select("*"),
      supabase.from("company_sla_overrides").select("*"),
    ]);

    if (pRes.error) toast.error("Erro ao carregar pagamentos");
    setPayments(pRes.data ?? []);
    setSlaSettings(slaRes.data ?? []);
    setSlaOverrides(ovrRes.data ?? []);
    setLoading(false);
  }, []);

  useEffect(() => {
    document.title = "Pagamentos | MedPay";
    load();
  }, [load]);

  const filtered = useMemo(() => {
    return payments.filter((p) => {
      const matchesSearch = !search || 
        p.reference.toLowerCase().includes(search.toLowerCase()) ||
        p.description?.toLowerCase().includes(search.toLowerCase());
      
      const matchesStatus = statusFilter.length === 0 || statusFilter.includes(p.status);
      
      const matchesCompany = !companyFilter || 
        p.payment_company_groups.some((g: any) => g.company_name === companyFilter.name);

      return matchesSearch && matchesStatus && matchesCompany;
    });
  }, [payments, search, statusFilter, companyFilter]);

  const reprocessSelected = async () => {
    if (selected.size === 0) return;
    setReprocessing(true);
    setReprocessProgress({ done: 0, total: selected.size });
    
    let done = 0;
    for (const id of selected) {
      try {
        await supabase.functions.invoke("analyze-payment", { body: { payment_id: id } });
      } catch (e) {
        console.error("Falha ao reprocessar", id, e);
      }
      done++;
      setReprocessProgress({ done, total: selected.size });
    }
    
    setReprocessing(false);
    setReprocessProgress(null);
    setSelected(new Set());
    toast.success("Reprocessamento concluído");
    load();
  };

  return (
    <div className="flex flex-col h-full w-full max-w-[100vw] overflow-x-hidden">
      <PageHeader 
        title="Pagamentos" 
        description="Gestão de lotes de pagamento e conciliação."
        actions={
          <div className="flex items-center gap-2">
            {selected.size > 0 && (
              <Button variant="destructive" size="sm" onClick={reprocessSelected} disabled={reprocessing}>
                {reprocessing ? <Loader2 className="h-4 w-4 mr-2 animate-spin" /> : <RefreshCcw className="h-4 w-4 mr-2" />}
                Reprocessar {selected.size} selecionado(s)
              </Button>
            )}
            <Button asChild>
              <Link to="/pagamentos/novo"><Plus className="h-4 w-4 mr-2" /> Novo lote</Link>
            </Button>
          </div>
        }
      />

      <div className="p-4 md:p-8 w-full mx-auto space-y-6">
        <div className="flex flex-wrap items-center gap-3">
          <div className="relative flex-1 min-w-[240px]">
            <Search className="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground" />
            <Input 
              placeholder="Buscar por referência ou descrição..." 
              className="pl-9"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />
          </div>
          <CompanyCombobox 
            value={companyFilter} 
            onChange={setCompanyFilter} 
            placeholder="Filtrar por empresa..." 
            className="w-[240px]"
          />
          <ToggleGroup type="multiple" value={statusFilter} onValueChange={setStatusFilter} className="flex-wrap justify-start">
            <ToggleGroupItem value="em_analise_ia" className="text-xs">Análise IA</ToggleGroupItem>
            <ToggleGroupItem value="revisao_analista" className="text-xs">Revisão</ToggleGroupItem>
            <ToggleGroupItem value="aguardando_validacao" className="text-xs">Validação</ToggleGroupItem>
            <ToggleGroupItem value="aprovado" className="text-xs">Aprovados</ToggleGroupItem>
          </ToggleGroup>
        </div>

        {reprocessProgress && (
          <Card className="border-primary/30 bg-primary/5">
            <CardContent className="p-4 space-y-2">
              <div className="flex justify-between text-sm font-medium">
                <span>Reprocessando lotes...</span>
                <span>{Math.round((reprocessProgress.done / reprocessProgress.total) * 100)}%</span>
              </div>
              <Progress value={(reprocessProgress.done / reprocessProgress.total) * 100} />
            </CardContent>
          </Card>
        )}

        <div className="grid gap-4">
          {filtered.map((p) => {
            const sla = evaluateSla(p, slaSettings, slaOverrides);
            const risk = getGroupRisk(p.payment_company_groups);
            return (
              <SafeCard key={p.id} className="shadow-card hover:shadow-md transition-shadow p-0">
                <CardContent className="p-0">
                  <div className="flex items-center justify-between p-4 border-b border-border/50 gap-4">
                    <div className="flex items-center gap-3 min-w-0">
                      <div className="shrink-0">
                        <Checkbox 
                          checked={selected.has(p.id)} 
                          onCheckedChange={(c) => {
                            const n = new Set(selected);
                            c ? n.add(p.id) : n.delete(p.id);
                            setSelected(n);
                          }}
                        />
                      </div>
                      <div className="min-w-0">
                        <Link to={`/pagamentos/${p.id}`} className="font-semibold hover:text-primary transition-colors truncate block">
                          {p.reference}
                        </Link>
                        <p className="text-xs text-muted-foreground truncate">{p.description || "Sem descrição"}</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-4 shrink-0">
                      <div className="text-right">
                        <p className="text-sm font-bold whitespace-nowrap">{formatCurrency(p.total_amount)}</p>
                        <p className="text-[10px] text-muted-foreground">{p.items_count} itens</p>
                      </div>
                      <StatusBadge status={p.status} />
                    </div>
                  </div>
                  <div className="p-4 flex items-center justify-between gap-4 text-xs text-muted-foreground flex-wrap">
                    <div className="flex items-center gap-4">
                      <span className="flex items-center gap-1.5 whitespace-nowrap"><CalendarDays className="h-3.5 w-3.5" /> {formatCompetence(p.competence_months?.length ? p.competence_months : p.competence_month)}</span>
                      {sla && (
                        <span className={cn("flex items-center gap-1.5 whitespace-nowrap", sla.daysLeft < 0 ? "text-destructive" : "text-warning")}>
                          <Clock className="h-3.5 w-3.5" /> {sla.daysLeft < 0 ? `Atrasado ${Math.abs(sla.daysLeft)}d` : `${sla.daysLeft}d restantes`}
                        </span>
                      )}
                    </div>
                    <div className="flex items-center gap-2">
                      {risk.score > 0 && <RiskBadge level={risk.level} score={risk.score} />}
                      <Button variant="ghost" size="sm" asChild>
                        <Link to={`/pagamentos/${p.id}`}>Ver detalhes</Link>
                      </Button>
                    </div>
                  </div>
                </CardContent>
              </SafeCard>
            );
          })}
        </div>
      </div>
    </div>
  );
};

export default Payments;
